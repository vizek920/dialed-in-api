# المنفذ (Render يحدده تلقائيًا، لا تضعه هناك)
PORT=3001

# روابط الواجهة المسموح لها بالاتصال، مفصولة بفاصلة
# محليًا:
CLIENT_ORIGINS=http://localhost:5173
# بعد النشر أضف رابط Vercel، مثال:
# CLIENT_ORIGINS=https://dialed-in.vercel.app,http://localhost:5173

# سيُضاف في مرحلة الربط (Supabase)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# JWT_SECRET=

# ملح لتشفير بصمة العناوين المحظورة (اكتب أي نص عشوائي طويل)
IP_SALT=change-me
